{%- set t = i18n[lang] -%}
{#- Same page in each language: English lives at /, Korean under /ko/ -#}
{%- set enUrl = page.url | replace("/ko/", "/") if lang == "ko" else page.url -%}
{%- set koUrl = "/ko" + enUrl -%}
<!DOCTYPE html>
<html lang="{{ lang }}">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title or t.meta.title }}</title>
    <meta name="description" content="{{ description or t.meta.description }}">
    <meta name="color-scheme" content="light">
    <meta property="og:title" content="{{ title or t.meta.title }}">
    <meta property="og:description" content="{{ description or t.meta.description }}">
    <meta property="og:locale" content="{{ t.locale }}">
    <link rel="alternate" hreflang="en" href="{{ site.url }}{{ enUrl }}">
    <link rel="alternate" hreflang="ko" href="{{ site.url }}{{ koUrl }}">
    <link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ enUrl }}">
    <script>document.documentElement.classList.add('js');</script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    {%- if lang == "ko" %}
    <link href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" rel="stylesheet">
    {%- endif %}
    <link rel="stylesheet" href="/assets/css/style.css">
</head>

<body>
    {% include "partials/header.njk" %}

    {{ content | safe }}

    {% include "partials/footer.njk" %}

    <script src="/assets/js/main.js"></script>
</body>

</html>
