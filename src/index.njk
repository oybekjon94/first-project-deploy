---
layout: layouts/base.njk
pagination:
    data: languages
    size: 1
    alias: lang
permalink: "{{ i18n[lang].home }}"
---
{%- set t = i18n[lang] -%}
<main>
    <!-- Hero -->
    <section class="container hero" id="hero">
        <div class="hero-text">
            <p class="section-label reveal">{{ t.hero.eyebrow | safe }}</p>
            <h1 class="hero-title reveal">{{ t.hero.title | safe }}</h1>
            <p class="hero-desc reveal">{{ t.hero.desc }}</p>
            <div class="hero-actions reveal">
                <a href="{{ t.home }}#contact" class="btn btn-primary btn-lg">
                    {{ t.hero.cta }}
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </a>
                <a href="{{ site.cv }}" class="btn btn-secondary btn-lg" target="_blank" rel="noopener">
                    {{ t.hero.cv }}
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v12M6 11l6 6 6-6M5 20h14"/></svg>
                </a>
            </div>
        </div>

        <div class="hero-photo reveal">
            <img src="/assets/images/profile.jpg" alt="{{ t.hero.photoAlt }}" width="460" height="460">
            <span class="hero-badge">{{ t.hero.badge }}</span>
        </div>
    </section>

    <!-- Quick facts strip -->
    <div class="container">
        <ul class="facts reveal">
            {%- for fact in t.hero.facts %}
            <li>{{ fact }}</li>
            {%- endfor %}
        </ul>
    </div>

    <!-- Selected work: projects marked `featured: true` -->
    <section class="container work" id="work">
        <p class="section-label on-scroll">{{ t.work.label }}</p>
        <h2 class="section-title on-scroll">{{ t.work.title }}</h2>

        <div class="projects-grid">
            {#- asyncEach (not for): the card's image shortcode is async -#}
            {%- asyncEach project in collections.projects | featured %}
            {% include "partials/project-card.njk" %}
            {%- endeach %}
        </div>

        <a href="{{ t.home }}work/" class="btn btn-secondary btn-lg see-all on-scroll">
            {{ t.work.seeAll }}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
    </section>

    <!-- What I do -->
    <section class="services section-dark" id="about">
        <div class="container">
            <p class="section-label on-scroll">{{ t.services.label }}</p>
            <h2 class="section-title on-scroll">{{ t.services.title }}</h2>
            <p class="section-desc on-scroll">{{ t.services.desc }}</p>
            <ol class="services-grid on-scroll">
                {%- for service in services %}
                <li class="service">
                    <span class="service-num">{{ "0" if loop.index < 10 }}{{ loop.index }}</span>
                    <h3>{{ service[lang].title }}</h3>
                    <p>{{ service[lang].text }}</p>
                </li>
                {%- endfor %}
            </ol>
        </div>
    </section>

    <!-- Blog: latest 4 posts -->
    <section class="container blog" id="blog">
        <p class="section-label on-scroll">{{ t.blog.label }}</p>
        <h2 class="section-title on-scroll">{{ t.blog.title }}</h2>

        <div class="posts-grid">
            {#- asyncEach (not for): the card's image shortcode is async -#}
            {%- asyncEach post in collections.posts | limit(4) %}
            {% include "partials/post-card.njk" %}
            {%- endeach %}
        </div>

        {#- Blog page comes later — the button stays disabled until then -#}
        <span class="btn btn-secondary btn-lg see-all is-disabled on-scroll" aria-disabled="true">
            {{ t.blog.seeAll }}<span class="soon">{{ t.nav.soon }}</span>
        </span>
    </section>

    <!-- Let's talk -->
    <section class="container contact" id="contact">
        <div class="contact-card">
            <p class="section-label on-scroll">{{ t.contact.label }}</p>
            <h2 class="section-title on-scroll">{{ t.contact.title }}</h2>
            <p class="section-desc on-scroll">{{ t.contact.desc }}</p>

            <div class="contact-grid">
                <ol class="contact-steps on-scroll">
                    {%- for step in t.contact.steps %}
                    <li>
                        <span class="service-num">0{{ loop.index }}</span>
                        <h3>{{ step.title }}</h3>
                        <p>{{ step.text }}</p>
                    </li>
                    {%- endfor %}
                </ol>

                {#- No form service: JS opens the visitor's email app with the message filled in; plain mailto without JS -#}
                <form class="contact-form on-scroll" action="mailto:{{ site.email }}" method="post" enctype="text/plain"
                    data-email="{{ site.email }}" data-subject="{{ t.contact.form.subject }}">
                    <div class="field">
                        <label for="contact-name">{{ t.contact.form.name }}</label>
                        <input id="contact-name" name="name" type="text" autocomplete="name" placeholder="{{ t.contact.form.namePlaceholder }}" required>
                    </div>
                    <div class="field">
                        <label for="contact-email">{{ t.contact.form.email }}</label>
                        <input id="contact-email" name="email" type="email" autocomplete="email" placeholder="{{ t.contact.form.emailPlaceholder }}" required>
                    </div>
                    <div class="field field-full">
                        <label for="contact-message">{{ t.contact.form.message }}</label>
                        <textarea id="contact-message" name="message" rows="4" placeholder="{{ t.contact.form.messagePlaceholder }}" required></textarea>
                    </div>
                    <div class="field-full">
                        <button type="submit" class="btn btn-primary btn-lg">
                            {{ t.contact.form.submit }}
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                        </button>
                        <p class="contact-note">{{ t.contact.form.note }} <a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
                    </div>
                </form>
            </div>
        </div>
    </section>
</main>
